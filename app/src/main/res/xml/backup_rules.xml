<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below. Same reasoning as data_extraction_rules.xml: an encrypted database cannot be
    restored onto a device whose keystore never held its key, and receipt photos would be orphans.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="receipts" />
</full-backup-content>
